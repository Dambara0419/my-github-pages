---
import Layout from '../layouts/Layout.astro'
import { withBase } from '../utils/withBase'

interface PageLink {
  href: string
  title: string
  description: string
  tag: string
  /** 24×24 の線画アイコン（stroke で描く path の d） */
  icon: string[]
}

const pages: PageLink[] = [
  {
    href: '/otohifu/', title: 'Otohifu', tag: 'Sound',
    description: '肘の皮膚の伸びを試すメインページ',
    icon: ['M2 12c1.5-5 3.5-5 5 0s3.5 5 5 0 3.5-5 5 0 3.5 5 5 0'],
  },
  {
    href: '/otohifu_accelator/', title: 'Otohifu Accelator', tag: 'Sensor',
    description: '加速度センサー版の計測ページ',
    icon: ['M9 3h6a1.5 1.5 0 0 1 1.5 1.5v15A1.5 1.5 0 0 1 15 21H9a1.5 1.5 0 0 1-1.5-1.5v-15A1.5 1.5 0 0 1 9 3z', 'M11 18h2', 'M4 9v6', 'M20 9v6'],
  },
  {
    href: '/ca/', title: 'CA', tag: 'Simulation',
    description: 'セル・オートマトンの実験ページ',
    icon: ['M10 4h4v4h-4z', 'M16 10h4v4h-4z', 'M4 16h4v4H4z', 'M10 16h4v4h-4z', 'M16 16h4v4h-4z'],
  },
  {
    href: '/img2obj/', title: 'img2obj', tag: '3D Print',
    description: '画像からオブジェクト化するページ',
    icon: ['M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z', 'M4 7.5l8 4.5 8-4.5', 'M12 12v9'],
  },
  {
    href: '/thatcher.html', title: 'サッチャー錯視', tag: 'Vision',
    description: 'カメラで撮影した自分の顔でサッチャー錯視を体験するページ',
    icon: ['M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z', 'M9 10h.01', 'M15 10h.01', 'M9 16.5c1.7-1.6 4.3-1.6 6 0'],
  },
  {
    href: '/spiman/', title: 'SpiMan 設計支援', tag: 'Robotics',
    description: '触手型機構をパラメータで設計し、巻き取りをシミュレーションして 3D プリント用データを書き出すページ',
    icon: ['M12 12a2 2 0 0 1 4 0 4 4 0 0 1-8 0 6 6 0 0 1 12 0 8 8 0 0 1-16 0'],
  },
]
---

<Layout bodyClass="bg-slate-50 text-slate-900">
  <div class="relative isolate min-h-screen overflow-hidden">
    {/* 背景：淡いぼかしの光とドットグリッド */}
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-40 -left-32 size-[36rem] rounded-full bg-sky-200/50 blur-3xl"></div>
      <div class="absolute top-10 -right-40 size-[32rem] rounded-full bg-cyan-100/70 blur-3xl"></div>
      <div class="absolute top-[28rem] left-1/3 size-[28rem] rounded-full bg-indigo-100/40 blur-3xl"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgb(148_163_184/0.35)_1px,transparent_0)] bg-size-[22px_22px] mask-[linear-gradient(to_bottom,black,transparent_70%)]"></div>
    </div>

    <main class="mx-auto w-full max-w-6xl px-6 pt-20 pb-24 md:pt-28">
      <header class="max-w-3xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/70 px-3 py-1 text-xs font-medium tracking-[0.2em] text-slate-500 uppercase backdrop-blur">
          <span class="size-1.5 rounded-full bg-sky-500"></span>
          {pages.length} experiments
        </p>
        <h1 class="mt-6 text-5xl font-semibold tracking-tight text-slate-900 md:text-7xl">
          Experiment <span class="bg-linear-to-r from-sky-500 to-cyan-400 bg-clip-text text-transparent">Hub</span>
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-500 md:text-lg md:leading-8">
          計測・可視化・画像処理・ものづくりの実験ページをまとめています。気になるものから触ってみてください。
        </p>
      </header>

      <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {pages.map((page) => (
          <li>
            <a
              href={withBase(page.href)}
              class="group flex h-full flex-col rounded-2xl border border-slate-200/80 bg-white/70 p-6 shadow-[0_1px_2px_rgb(15_23_42/0.04)] backdrop-blur transition duration-200 hover:-translate-y-0.5 hover:border-sky-300 hover:bg-white hover:shadow-[0_12px_32px_-12px_rgb(14_165_233/0.35)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500"
            >
              <div class="flex items-center justify-between">
                <span class="grid size-11 place-items-center rounded-xl bg-sky-50 text-sky-600 ring-1 ring-sky-100 transition group-hover:bg-sky-500 group-hover:text-white group-hover:ring-sky-500">
                  <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {page.icon.map((d) => <path d={d} />)}
                  </svg>
                </span>
                <span class="rounded-full border border-slate-200 px-2.5 py-0.5 text-[11px] font-medium tracking-wider text-slate-500 uppercase">
                  {page.tag}
                </span>
              </div>
              <h2 class="mt-5 text-lg font-semibold text-slate-900">{page.title}</h2>
              <p class="mt-2 flex-1 text-sm leading-6 text-slate-500">{page.description}</p>
              <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4 text-xs">
                <span class="font-mono text-slate-400">{page.href}</span>
                <span class="font-medium text-sky-600 transition group-hover:translate-x-0.5">開く →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </main>

    <footer class="border-t border-slate-200/70 py-8 text-center text-xs text-slate-400">
      Experiment Hub · Built with Astro &amp; React
    </footer>
  </div>
</Layout>
